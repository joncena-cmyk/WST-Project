        {
          "name": "Attendance — POST Check-In (AJAX)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",    "value": "application/json" },
              { "key": "X-XSRF-TOKEN",   "value": "{{CSRF_TOKEN}}" },
              { "key": "Accept",          "value": "application/json" },
              { "key": "X-Requested-With","value": "XMLHttpRequest" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"qr_token\": \"INVALID_TOKEN_TEST\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{BASE_URL}}/attendance/checkin/{{EVENT_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["attendance", "checkin", "{{EVENT_ID}}"]
            },
            "description": "AJAX check-in endpoint. Sending an invalid token should return an error JSON, not a crash."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
