          "name": "Auth — Unauthenticated dashboard redirects to login",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/dashboard",
              "host": ["{{BASE_URL}}"],
              "path": ["dashboard"]
            },
            "description": "Without session cookie the dashboard must redirect to /login."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Clear session to simulate unauthenticated request",
                  "pm.cookies.clear();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthenticated dashboard redirects (302 or lands on login page)', function () {",
                  "    // After redirect following, we should be on the login page",
                  "    const body = pm.response.text();",
                  "    const isLoginOrRedirect = pm.response.code === 302 ||",
                  "        body.includes('Sign in') ||",
                  "        body.includes('login');",
                  "    pm.expect(isLoginOrRedirect).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }

      ]
