{
  "info": {
    "name": "COMSOC Hub",
    "description": "Full API test collection for COMSOC Hub — Computer Society · CCIS · University of Makati.\n\nStack: Laravel 11 · Blade · Tailwind CSS · Alpine.js · MySQL\n\nNotes:\n- This is a session-based web app (no REST API tokens). CSRF token must be obtained before mutating requests.\n- The prerequest script on the collection root fetches the CSRF token automatically.\n- Run the 'Auth — Login (Admin)' request first to establish a session cookie.\n- {{BASE_URL}} defaults to http://localhost/WST-Project/public",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost/WST-Project/public", "type": "string", "description": "Application base URL" },
    { "key": "CSRF_TOKEN", "value": "", "type": "string", "description": "Laravel XSRF token extracted from cookie" },
    { "key": "EVENT_ID",   "value": "1", "type": "string", "description": "Set by 'Events — Create' test script" },
    { "key": "POST_ID",    "value": "1", "type": "string", "description": "Set by 'Community — Create Post' test script" },
    { "key": "COMMENT_ID", "value": "1", "type": "string", "description": "Set by 'Community — Add Comment' test script" },
    { "key": "REG_ID",     "value": "1", "type": "string", "description": "Set by 'Events — Register' test script" },
    { "key": "CERT_ID",    "value": "1", "type": "string", "description": "Set by 'Certificates — Issue' test script" },
    { "key": "MEMBERSHIP_ID", "value": "1", "type": "string", "description": "Set by 'Admin Memberships — Create' test script" },
    { "key": "USER_ID",    "value": "1", "type": "string", "description": "Admin target user ID for user management tests" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatically refresh CSRF token before every request",
          "// Laravel sets the XSRF-TOKEN cookie on GET requests.",
          "// We read it from the cookie jar and store it as a collection variable.",
          "const xsrfCookie = pm.cookies.get('XSRF-TOKEN');",
          "if (xsrfCookie) {",
          "    pm.collectionVariables.set('CSRF_TOKEN', decodeURIComponent(xsrfCookie));",
          "}"
        ]
      }
    }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [

        {
          "name": "Auth — GET Login Page (fetch CSRF)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/login",
              "host": ["{{BASE_URL}}"],
              "path": ["login"]
            },
            "description": "Fetches the login page. Laravel sets the XSRF-TOKEN cookie here, which subsequent POST requests need."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login page returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is HTML', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');",
                  "});",
                  "// Capture CSRF token from cookie",
                  "const xsrf = pm.cookies.get('XSRF-TOKEN');",
                  "if (xsrf) {",
                  "    pm.collectionVariables.set('CSRF_TOKEN', decodeURIComponent(xsrf));",
                  "    console.log('CSRF token captured.');",
                  "} else {",
                  "    console.warn('XSRF-TOKEN cookie not found. Is the app running?');",
                  "}"
                ]
              }
            }
          ]
        },

        {
          "name": "Auth — Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
              { "key": "X-XSRF-TOKEN", "value": "{{CSRF_TOKEN}}" },
              { "key": "Accept", "value": "application/json, text/html" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "_token", "value": "{{CSRF_TOKEN}}" },
                { "key": "email",  "value": "admin@umak.edu.ph" },
                { "key": "password", "value": "Admin@COMSOC2025!" }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/login",
              "host": ["{{BASE_URL}}"],
              "path": ["login"]
            },
            "description": "Logs in with the seeded admin account. Session cookie is stored automatically by Postman's cookie jar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login redirects to dashboard (302 or 200)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});",
                  "pm.test('No error in response', function () {",
                  "    const body = pm.response.text();",
                  "    pm.expect(body).to.not.include('These credentials do not match');",
                  "});"
                ]
              }
            }
          ]
        },

        {
          "name": "Auth — Register (valid @umak.edu.ph email)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
              { "key": "X-XSRF-TOKEN", "value": "{{CSRF_TOKEN}}" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "_token",              "value": "{{CSRF_TOKEN}}" },
                { "key": "name",               "value": "Test Student" },
                { "key": "email",              "value": "teststudent{{$randomInt}}@umak.edu.ph" },
                { "key": "student_id",         "value": "2025-{{$randomInt}}" },
                { "key": "program_id",         "value": "1" },
                { "key": "password",           "value": "Password@123!" },
                { "key": "password_confirmation", "value": "Password@123!" }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/register",
              "host": ["{{BASE_URL}}"],
              "path": ["register"]
            },
            "description": "Registers a new user. The UmakEmail rule now requires @umak.edu.ph. Should succeed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration succeeds (no validation error)', function () {",
                  "    const body = pm.response.text();",
                  "    pm.expect(body).to.not.include('Only @umak.edu.ph email addresses are allowed');",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});"
                ]
              }
            }
          ]
        },

        {
          "name": "Auth — Register (REJECT non-umak email)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
              { "key": "X-XSRF-TOKEN", "value": "{{CSRF_TOKEN}}" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "_token",              "value": "{{CSRF_TOKEN}}" },
                { "key": "name",               "value": "Outsider User" },
                { "key": "email",              "value": "outsider@gmail.com" },
                { "key": "student_id",         "value": "9999-001" },
                { "key": "program_id",         "value": "1" },
                { "key": "password",           "value": "Password@123!" },
                { "key": "password_confirmation", "value": "Password@123!" }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/register",
              "host": ["{{BASE_URL}}"],
              "path": ["register"]
            },
            "description": "Attempts to register with a non-@umak.edu.ph email. The UmakEmail rule must reject it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Non-umak email is rejected with validation error', function () {",
                  "    const body = pm.response.text();",
                  "    // Laravel returns 422 (JSON) or redirects back with errors (HTML)",
                  "    const isValidationError = pm.response.code === 422 ||",
                  "        body.includes('Only @umak.edu.ph email addresses are allowed');",
                  "    pm.expect(isValidationError).to.be.true;",
                  "});",
                  "pm.test('Response is not a successful redirect to dashboard', function () {",
                  "    const body = pm.response.text();",
                  "    pm.expect(body).to.not.include('dashboard');",
                  "});"
                ]
              }
            }
          ]
        },

        {
          "name": "Auth — Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
